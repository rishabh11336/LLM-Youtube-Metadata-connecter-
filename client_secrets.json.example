{
  "_comment": "This is an example showing the structure of client_secrets.json. Do NOT put real credentials here. Download the real file from Google Cloud Console and save it as client_secrets.json in the project root. The real client_secrets.json is gitignored.",
  "installed": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "project_id": "your-google-cloud-project-id",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_secret": "YOUR_CLIENT_SECRET",
    "redirect_uris": [
      "http://localhost"
    ]
  }
}
